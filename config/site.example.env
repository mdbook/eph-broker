# eph-broker site overlay. Copy to config/site.env (or point BROKER_SITE_ENV at it) and fill in your values.
# KEY=VALUE per line; the real environment always wins over this file. Not a shell file: no `export K=V`
# (such lines are skipped), no inline comments (`K=v  # note` puts "v  # note" in the value), one layer of
# matching quotes is stripped. Never put secrets here: they go in the broker's environment file
# (docs/configuration.md#secrets). docs/settings.md lists every setting.

# ======================================================================================================
# Quick start: a GitLab issue in, a merge request out (README.md "A first merge request").
# ======================================================================================================

# GitLab web root; the REST API defaults to <this>/api/v4 (override: GITLAB_API).
# Unset: no MR opening, no repo catalog, pipelines named by id only.
GITLAB_WEB_URL=https://gitlab.example.com
# SECURITY: the only hosts worker branches may be pushed to (https only, comma list). Unset: no pushes.
# Bare lowercase hostnames only ("https://h" or "h:443" never match; the broker warns at startup).
BROKER_PUSH_HOSTS=gitlab.example.com
# Issue intake. ISSUE_REPO_MAP: which local checkout each project's issues work in (unset: every issue is
# refused). ISSUE_AUTHOR_ALLOWLIST: usernames whose new issues may start a worker, case-insensitive (unset:
# nobody, so issue intake is off).
#ISSUE_REPO_MAP=gitlab:group/app=/srv/git/app
#ISSUE_AUTHOR_ALLOWLIST=your-username
# Per-repo code-worker test runner (`<abs-path>=<runner>,...`; runners: pytest/npm/go/venv/bash-n/
# ansible-syntax/none). Env CODE_REPO_RUNNERS overrides/extends per path. Unset: the route default runner.
#CODE_REPO_RUNNER_SEEDS=/srv/git/app=pytest
# Ticket links in comments and messages; `{}` = ticket id. Unset: plain "#<id>".
TICKET_URL_TEMPLATE=https://tracker.example.com/tasks/{}

# Where escalations go (docs/configuration.md#notifications): webhook or email. The default, zbus, is a chat
# CLI the original deployment used; without NOTIFY_ZBUS it only logs. OPS_HANDLE is the recipient: the
# webhook's `to`, or an email address. Unset: escalations are logged only. Secrets (NOTIFY_WEBHOOK_SECRET,
# NOTIFY_SMTP_PASSWORD) go in the broker's environment file.
#NOTIFY_BACKEND=webhook
#OPS_HANDLE=alerts@example.com
#NOTIFY_WEBHOOK_URL=https://hooks.example.com/eph
#NOTIFY_SMTP_HOST=smtp.example.com
#NOTIFY_SMTP_PORT=587
#NOTIFY_SMTP_STARTTLS=1
#NOTIFY_SMTP_USER=eph
#NOTIFY_EMAIL_FROM=eph@example.com

# ======================================================================================================
# Advanced: tracker tickets, other rows and integrations. Everything below is optional, and several parts
# were built for the original deployment (docs/settings.md marks which).
# ======================================================================================================

# The tracker script for ticket reads, comments and labels (docs/tracker-script.md). Unset: no tracker
# ticket can start a worker. Use an absolute path. Workers get its directory prepended to PATH, and their deny
# rules block `mcp.sh` there and in any other directory, so name the script mcp.sh.
#BROKER_MCP_SH=/usr/local/bin/mcp.sh
# Repos the code and general workers may use (colon lists of absolute paths; unset: none, fail closed), and
# the general worker's default repo. A tracker code ticket names its repo with a `repo:/abs/path` line;
# CODE_REPO and CODE_REPO_PATH are not a fallback for it.
#CODE_REPO_ALLOWLIST=/srv/git/app
#GENERAL_REPO_ALLOWLIST=/srv/git/app:/srv/git/docs
#GENERAL_REPO=/srv/git/app
#GENERAL_REPO_PATH=/srv/git/app
#CODE_REPO=/srv/git/app
#CODE_REPO_PATH=/srv/git/app
#ISSUE_CODE_REPO=/srv/git/app
#ISSUE_CODE_REPO_PATH=/srv/git/app
#MR_REVIEW_REPO=/srv/git/app
# Built-in row triggers (docs/configuration.md#built-in-rows). The code and general rows start on: label
# eph:code-change or assignee eph-code, label eph:general or assignee eph. Every other built-in row is off until
# you name its trigger here (it also needs its repo, prompt and accounts). An empty value turns a row off.
#DEV_ASSIGNEE=eph-code
#FLEET_ASSIGNEE=eph
#ANSIBLE_ROW_LABEL=ansible
#WIKI_ROW_LABEL=wiki
#INFRA_ASSIGNEE=infra-proposer
#FLEET_ASSIGNEE_ALT=agent
#INBOX_ROW_SOURCE=gmail
#ZULIP_ROW_SOURCE=zulip
# Repos of the other built-in rows (absolute paths). Unset: a row with no repo cannot cut a worktree.
#INFRA_REPO=/srv/infra
#INFRA_REPO_PATH=/srv/infra
#ANSIBLE_REPO=/srv/ansible
#WIKI_REPO=/srv/git/wiki
#WIKI_REPO_PATH=/srv/git/wiki
#INBOX_REPO=/srv/git/inbox
# POST /event signatures. BROKER_HMAC_SECRET is a secret, so it goes in the broker's environment file, not here.
# BROKER_HMAC_MODE defaults to enforce (unsigned events get 401); set log only while you add signing to a tap.
#BROKER_HMAC_MODE=enforce
# Tracker ids. PARKED_LABEL_ID: label applied when a worker comes back blocked (unset: no label). Coupled:
# that label's TITLE must also be in config/provenance.json handoff_parked_labels, or a parked ticket still hands off.
# DEV_VIKUNJA_UID: the code worker's assignee user id, for @-mention handoff. MENTION_HANDOFF_PROJECTS: comma
# list of project ids where a mention may hand off (unset: none).
#PARKED_LABEL_ID=7
#DEV_VIKUNJA_UID=13
#MENTION_HANDOFF_PROJECTS=3
# The name /rerun calls are logged and commented as. Unset: operator.
#RERUN_CALLER=admin
# Signed run events for n8n or similar (docs/events.md). Off when unset; EVENTS_WEBHOOK_SECRET goes in the
# environment file and is required. EVENTS_WEBHOOK_KINDS: comma list, default all four.
#EVENTS_WEBHOOK_URL=https://n8n.example.com/webhook/eph-events
#EVENTS_WEBHOOK_KINDS=run.finished,run.escalated,mr.opened
# Hand-off recipients, through the NOTIFY_BACKEND channel. CD_ANSIBLE_HANDLE gets the CD deploy hand-off line
# (docs/cd-deploy-paths.md); INFRA_MR_NOTIFY_HANDLE gets infra-row MR links. Unset: not sent.
#CD_ANSIBLE_HANDLE=deployer@example.com
#INFRA_MR_NOTIFY_HANDLE=infra@example.com
# The zbus channel (NOTIFY_BACKEND=zbus): the chat CLI, and the PATH of the sender's credentials file (the
# broker never reads it). Workers also get the CLI's absolute path in their deny rules.
#NOTIFY_ZBUS=/usr/local/bin/zbus
#NOTIFY_ZBUS_ENV=/etc/eph-broker/bot.env
# Chat identity files handed to a row's worker, so it can message OPS_HANDLE through zbus (zbus only).
# Unset: the row gets none.
#ANSIBLE_ZBUS_ENV=/etc/eph-broker/deploy-bot.env
#WIKI_ZBUS_ENV=/etc/eph-broker/bot.env
#INBOX_ZBUS_ENV=/etc/eph-broker/mail-bot.env
#CODE_ZBUS_ENV=/etc/eph-broker/bot.env
#ISSUE_CODE_ZBUS_ENV=/etc/eph-broker/bot.env
#INFRA_ZBUS_ENV=/etc/eph-broker/bot.env
#GENERAL_ZBUS_ENV=/etc/eph-broker/eph-bot.env

# Models and backends (docs/configuration.md#models-and-backends). FLEET_MODEL_SH: a script printing a full
# claude-* model id or a backend name for an agent name; unset: NATIVE_FALLBACK_MODEL (default claude-sonnet-5).
# SPAWN_MODELS_JSON: the backend registry. SPAWN_SH: the external launcher row's script. VLLM_CC_ENV: the env
# file a `local` backend reads when its entry has none. Unset: only native Claude, no launcher.
#FLEET_MODEL_SH=/usr/local/bin/pick-model.sh
#SPAWN_MODELS_JSON=/etc/eph-broker/spawn-models.json
#SPAWN_SH=/usr/local/bin/spawn.sh
#VLLM_CC_ENV=/etc/eph-broker/local-model.env
# TFA_BACKEND: the backend flag passed to SPAWN_SH (`--<name>`); unset: no flag. USAGE_CAP_FALLBACK_CHAIN: comma
# list of registry backends a capped worker retries on (with USAGE_CAP_FALLBACK_ENABLED); unset: no fallback.
# FLEET_USAGE_FILE: a usage snapshot JSON for skipping a capped Anthropic attempt up front; unset: not read.
#TFA_BACKEND=my-gateway
#USAGE_CAP_FALLBACK_CHAIN=my-gateway,my-local
#FLEET_USAGE_FILE=/run/eph-broker/usage.json

# Dashboard Fleet tab sources (docs/configuration.md#the-dashboard). Unset: the tab reports an error / no
# supervisor flags.
#FLEET_STATUS_PATH=/var/lib/eph-broker/agents-status.json
#FLEET_MD_PATH=/srv/agents/MODE.md
#SUPERVISOR_STATUS_PATH=/var/lib/eph-broker/supervisor-status.json
# Live-stream auth: the identity headers the reverse proxy's forward-auth sets (it MUST strip client-sent
# copies). Required with BROKER_STREAM_ENABLED; unset: every /stream 403s.
#BROKER_STREAM_USER_HEADER=X-Forwarded-User
#BROKER_STREAM_GROUPS_HEADER=X-Forwarded-Groups
#BROKER_STREAM_GROUPS_SEP=|

# Chat wake (original deployment only; only used when a ZULIP_* flag is on): the bot registry JSON and the
# listener script; user ids whose 1:1 DM wakes a mapped bot (unset: nobody); bots never auto-replied for; the
# retired-bot auto-reply ({bot} placeholder; unset: a neutral line naming no contact).
#ZULIP_REGISTRY_PATH=/var/lib/eph-broker/bot-registry.json
#ZULIP_MCP_SCRIPT=/usr/local/lib/chat-listener.py
#ZULIP_WAKE_SENDERS=99
#ZULIP_AUTOREPLY_EXCLUDE=paused-bot
#ZULIP_AUTOREPLY_TEXT={bot} is no longer in use, so nobody reads messages here.

# Repo inference (experimental; only with REPO_INFER_ENABLED=1, docs/repo-push-cred.md). REPO_CATALOG_NS: the
# GitLab namespace listed (unset: catalog unavailable). REPO_TIER_B (repos reachable only by an explicit `repo:`
# or exact name) and REPO_DENY (never reachable) are REQUIRED glob lists, empty allowed; unset: catalog
# unavailable, tickets ask.
#REPO_CATALOG_NS=you
#REPO_LOCAL_ROOTS=/srv/git
#REPO_LOCAL_DIRS=/srv/infra
#REPO_SUBPROJECT_REPOS=you/infra
#REPO_TIER_B=infra,deploy,*-agent
#REPO_DENY=private-*,mirrors/*
#REPO_WEAK_NAMES=docs,build,scripts
# Tracker usernames (besides the ticket's creator) whose comment may re-run a parked ticket; unset: creator only.
#REPO_INFER_RERUN_USERS=you
# Ticket creators whose `model:` label may pick a non-Anthropic backend; unset: nobody.
#MODEL_LABEL_TRUSTED_CREATORS=you,admin
# OpenAI-compatible chat endpoint for the second-opinion model step; unset: that step is skipped (the ticket asks).
#REPO_INFER_4B_URL=http://localhost:8000/v1/chat/completions
