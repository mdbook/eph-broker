      "parameters": {
        "jsCode": "// Check X-Eph-Signature against the raw body (docs/events.md). Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto and\n// N8N_BLOCK_ENV_ACCESS_IN_NODE=false for $env, or replace $env.EPH_EVENTS_SECRET with your own secret source.\nconst crypto = require('crypto');\nconst out = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const item = $input.all()[i];\n  const raw = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const want = 'sha256=' + crypto.createHmac('sha256', $env.EPH_EVENTS_SECRET).update(raw).digest('hex');\n  const got = String(item.json.headers['x-eph-signature'] || '');\n  if (want.length !== got.length || !crypto.timingSafeEqual(Buffer.from(want), Buffer.from(got))) {\n    throw new Error('bad X-Eph-Signature');\n  }\n  const evt = JSON.parse(raw.toString('utf8'));\n  if (Math.abs(Date.now() / 1000 - evt.ts) > 300) {\n    throw new Error('stale event');   // older than 5 minutes: a replay, or a clock problem\n  }\n  out.push({ json: evt });\n}\nreturn out;"
      },
      "name": "Check signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
