# The test site overlay (made-up values). tests/*.py point BROKER_SITE_ENV here so the suite behaves
# the same in this repo and in the public export (which ships no config/site.env). Mirrors config/site.env's keys.
TICKET_URL_TEMPLATE=https://tracker.example.test/tasks/{}
GITLAB_WEB_URL=https://gitlab.example.test
BROKER_PUSH_HOSTS=gitlab.example.test
OPS_HANDLE=admin-bot@chat.example.test
CD_ANSIBLE_HANDLE=deploy-bot@chat.example.test
INFRA_MR_NOTIFY_HANDLE=sysop-bot@chat.example.test
PARKED_LABEL_ID=92
DEV_VIKUNJA_UID=913
MENTION_HANDOFF_PROJECTS=912
NOTIFY_ZBUS=/opt/site/bin/zbus
NOTIFY_ZBUS_ENV=/etc/site/bots/.coder-bot-env
RERUN_CALLER=ops
BROKER_MCP_SH=/opt/site/bin/mcp.sh
SPAWN_MODELS_JSON=/etc/site/spawn-models.json
SPAWN_SH=/opt/site/bin/spawn.sh
VLLM_CC_ENV=/etc/site/.vllm-cc-env-eph
TFA_BACKEND=deepseek
USAGE_CAP_FALLBACK_CHAIN=deepseek,vLLM-Main
FLEET_USAGE_FILE=/var/lib/site/usage.json
ZULIP_REGISTRY_PATH=/var/lib/site/registry.json
ZULIP_MCP_SCRIPT=/opt/site/bin/zulip-mcp.py
ZULIP_WAKE_SENDERS=99
ZULIP_AUTOREPLY_EXCLUDE=agent-c-bot,agent-b-bot
ZULIP_AUTOREPLY_TEXT=Please DM admin-bot instead: {bot} is no longer in use. See https://wiki.example.test/retired for where its work went.
FLEET_MODEL_SH=/opt/site/bin/fleet-model.sh
GENERAL_REPO_ALLOWLIST=/srv/git/sample-app
CODE_REPO_ALLOWLIST=/srv/git/sample-app
GENERAL_REPO=/srv/git/sample-app
GENERAL_REPO_PATH=/srv/git/sample-app
CODE_REPO=/srv/git/sample-app
CODE_REPO_PATH=/srv/git/sample-app
ISSUE_CODE_REPO=/srv/git/sample-app
ISSUE_CODE_REPO_PATH=/srv/git/sample-app
MR_REVIEW_REPO=/srv/git/sample-app
INFRA_REPO=/srv/infra
INFRA_REPO_PATH=/srv/infra
ANSIBLE_REPO=/srv/ansible
WIKI_REPO=/srv/git/wiki
WIKI_REPO_PATH=/srv/git/wiki
INBOX_REPO=/srv/git/mail-agent
ANSIBLE_ZBUS_ENV=/etc/site/bots/.deploy-bot-env
WIKI_ZBUS_ENV=/etc/site/bots/.coder-bot-env
INBOX_ZBUS_ENV=/etc/site/bots/.mail-bot-env
CODE_ZBUS_ENV=/etc/site/bots/.coder-bot-env
ISSUE_CODE_ZBUS_ENV=/etc/site/bots/.coder-bot-env
INFRA_ZBUS_ENV=/etc/site/bots/.coder-bot-env
GENERAL_ZBUS_ENV=/etc/site/bots/.eph-bot-env
REPO_CATALOG_NS=owner
REPO_LOCAL_ROOTS=/srv/git:~/src
REPO_LOCAL_DIRS=/srv/infra:/srv/ansible
REPO_SUBPROJECT_REPOS=owner/docker
REPO_TIER_B=*-agent,agent-a,agent-b,agent-c,ansible,cards,coder-agent,docker,eph-broker,fleet,ops,sysop-agent,tool-a,tool-b,tool-c,tool-d,tool-e,wiki
REPO_DENY=repo-a-agent,repo-b-agent,mail-agent,repo-c-agent,mirrors/*,git-helper/*
REPO_WEAK_NAMES=agents,build,docker,fleet,gallery,ops,scripts,widgets,wiki
REPO_INFER_RERUN_USERS=owner
MODEL_LABEL_TRUSTED_CREATORS=owner,ops
REPO_INFER_4B_URL=http://llm.example.test:8000/v1/chat/completions
FLEET_STATUS_PATH=/var/lib/site/fleet-status.json
FLEET_MD_PATH=/srv/git/site/MODE.md
SUPERVISOR_STATUS_PATH=/var/lib/site/supervisor-status.json
CODE_REPO_RUNNER_SEEDS=/srv/git/sample-app=venv,/home/owner/src/eph-broker=pytest,/srv/git/agents=venv,/srv/git/site=bash-n,/srv/git/coder-agent=bash-n,/srv/ansible=ansible-syntax
BROKER_STREAM_USER_HEADER=X-Auth-Username
BROKER_STREAM_GROUPS_HEADER=X-Auth-Groups
ANSIBLE_ROW_LABEL=ansible
WIKI_ROW_LABEL=wiki
INBOX_ROW_SOURCE=gmail
ZULIP_ROW_SOURCE=zulip
DEV_ASSIGNEE=dev
INFRA_ASSIGNEE=infra-eph
FLEET_ASSIGNEE_ALT=fleet
